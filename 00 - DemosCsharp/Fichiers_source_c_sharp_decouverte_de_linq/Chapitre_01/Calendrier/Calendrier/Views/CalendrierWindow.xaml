<Window x:Class="Calendrier.Views.CalendrierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converter="clr-namespace:Calendrier.Converter"
        Title="Calendrier des sessions" Height="350" Width="525">
    <Window.Resources>
        <Style x:Key="GroupHeaderStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander x:Name="exp" IsExpanded="True"
                          Background="White"
                          Foreground="Black">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Path=Name}" />
                                    <TextBlock Text=" - "/>
                                    <TextBlock Text="{Binding Path=ItemCount}"/>
                                    <TextBlock Text=" sessions"/>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter /><!--le contenu !!-->
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <converter:WeekConverter x:Key="WeekConverter" />

        <CollectionViewSource x:Key="cvs" Source="{Binding sessions,UpdateSourceTrigger=PropertyChanged}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="DateDebut" Converter="{StaticResource WeekConverter}"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <Grid>
        <StackPanel>
            <ToolBar x:Name="tb" HorizontalAlignment="Left" Width="517">
                <DatePicker x:Name="dp" SelectedDate="2011-01-01" SelectedDateChanged="dp_SelectedDateChanged"></DatePicker>
                <Button x:Name="btnPage2" Content="Infos" Click="btnPage2_Click" />
            </ToolBar>
            <TextBlock x:Name="Titre" Margin="10" FontSize="20">Calendrier</TextBlock>
            <DataGrid x:Name="dgData" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  ItemsSource="{Binding Source={StaticResource cvs}}">
                <DataGrid.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}"></GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                <DataGridTextColumn Header="DateDebut" Binding="{Binding DateDebut, StringFormat={}{0:dd/MM/yyyy}}"/>
                <DataGridTextColumn Header="Titre" Binding="{Binding Titre}"/>
                <DataGridTextColumn Header="Duree" Binding="{Binding Duree}"/>
                <DataGridTextColumn Header="Inscrits" Binding="{Binding Inscrits}"/>
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="btnAnnule" ToolTip="Annule la session" Click="btnAnnule_Click">Annuler</Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </StackPanel>
    </Grid>
</Window>
